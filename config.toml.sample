[app]
# Interface and port where the app will run its webserver.  The default value
# of localhost will only listen to connections from the current machine. To
# listen on all interfaces use '0.0.0.0'. To listen on the default web address
# port, use port 80 (this will require running with elevated permissions).
address = "localhost:9000"

# Database.
[db]
# "postgres" (default) or "sqlite". For sqlite, only `path` below is used:
# the database file (created on --install).
driver = "postgres"
path = "listmonk.db"

host = "localhost"
port = 5432
user = "listmonk"
password = "listmonk"

# Ensure that this database has been created in Postgres.
database = "listmonk"

ssl_mode = "disable"
max_open = 25
max_idle = 25
max_lifetime = "300s"

# Optional space separated Postgres DSN params. eg: "application_name=listmonk gssencmode=disable"
params = ""

# API access with OAuth 2.0 access tokens (JWTs) from an identity provider,
# sent as `Authorization: Bearer <token>`, for example by a gateway that
# acts for a logged-in person (fork-only). A token acts as the existing
# listmonk user with the token's e-mail (`email`, with `email_verified`
# true), with that user's own permissions; users aren't created. Refused:
# other issuers, audiences or clients (`client_id`, else `azp`), ID and
# refresh tokens, unknown, disabled or API users. listmonk's own 2FA isn't
# asked for: the identity provider's login applies. Set only here or in the
# environment, e.g. LISTMONK_api_jwt__clients="sgnl-mcp".
[api_jwt]
enabled = false
# Issuer URL (its /.well-known/openid-configuration gives the JWKS).
issuer = ""
# The token's `aud` must contain one of these.
audiences = ["listmonk"]
# The client the token was issued to must be one of these.
clients = []
